flowchart LR
    classDef node-start fill:#000000,stroke:#00ff88,color:#e0e0e0
    classDef node-end fill:#000000,stroke:#ff0055,color:#e0e0e0
    classDef node-process fill:#000000,stroke:#8b5cf6,color:#e0e0e0
