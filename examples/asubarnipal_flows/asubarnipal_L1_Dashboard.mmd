%% asubarnipal · dashboard
%%{init: {"securityLevel": "loose", "themeVariables": {"lineColor": "#00ff88"}}}%%
flowchart TD
    classDef node-start fill:#000000,stroke:#00ff88,color:#e0e0e0
    classDef node-end fill:#000000,stroke:#ff0055,color:#e0e0e0
    classDef node-process fill:#000000,stroke:#8b5cf6,color:#e0e0e0
    classDef node-decision fill:#000000,stroke:#facc15,color:#e0e0e0
    classDef node-subprocess fill:#000000,stroke:#00ffff,color:#e0e0e0
    classDef node-tool fill:#000000,stroke:#00ff88,color:#e0e0e0
    classDef node-loop fill:#000000,stroke:#ff00ff,color:#e0e0e0
    classDef evolution fill:#000000,stroke:#ff8800,stroke-dasharray: 5 5,color:#e0e0e0
    classDef added fill:#a7f3d0,stroke:#065f46
    classDef removed fill:#fecaca,stroke:#991b1b,stroke-dasharray: 5 5
    classDef changed fill:#fde68a,stroke:#92400e
    n_start(["Start"])
    mod_avatar["Avatar<br><i>7 nodos, 6 enlaces</i>"]
    n_end(["End"])
    mod_tabs[["Tabs<br><i>15 sub-flujos</i>"]]
    mod_app_config[["App Config<br><i>11 nodos, 9 enlaces</i>"]]
    n_start --> mod_tabs
    mod_tabs --> mod_avatar
    mod_avatar --> mod_app_config
    mod_app_config --> n_end
    class n_start node-start
    class mod_tabs,mod_app_config node-subprocess
    class mod_avatar node-loop
    class n_end node-end
    click mod_tabs href "asubarnipal_L2_Dashboard_Tabs.html" "Abrir detalle"
    click mod_avatar href "asubarnipal_L2_Dashboard_Components_Avatar.html" "Abrir detalle"
